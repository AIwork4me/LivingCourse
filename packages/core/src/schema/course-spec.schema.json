{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingcourse.dev/schema/course-spec-v0.2.json",
  "title": "LivingCourse CourseSpec v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["courseSpecVersion", "course", "materials", "slides", "governance"],
  "properties": {
    "courseSpecVersion": { "const": "0.2.0" },
    "course": { "$ref": "#/$defs/courseIdentity" },
    "materials": { "type": "array", "items": { "$ref": "#/$defs/materialSpec" } },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slideSpec" } },
    "governance": { "$ref": "#/$defs/courseGovernance" }
  },
  "$defs": {
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "sourceClass": { "enum": ["controlled_internal", "external_authoritative", "reference", "synthetic", "unknown"] },
    "releaseScope": { "enum": ["poc_only", "author_review", "production"] },
    "reviewStatus": { "enum": ["pending", "approved_for_poc_use", "approved_for_release", "changes_required", "rejected"] },
    "courseIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "version", "locale", "audience", "purpose", "aspectRatio"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "audience": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "aspectRatio": { "const": "16:9" }
      }
    },
    "materialSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "path", "ref", "sha256", "title", "version", "effectiveDate", "authority", "sourceClass", "availability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["sop", "pdf", "docx", "pptx", "markdown", "image", "equipment_photo", "web_reference", "synthetic_source"] },
        "path": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "effectiveDate": { "type": ["string", "null"], "format": "date" },
        "authority": { "type": "string", "minLength": 1 },
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "availability": { "enum": ["available", "missing"] }
      }
    },
    "knowledgeItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "text", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "items": { "type": "string" } },
        "visualRequirementRef": { "type": "string", "minLength": 1 }
      }
    },
    "knowledgeBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "summary", "items"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/knowledgeItem" } },
        "safetyRule": { "type": "string", "minLength": 1 },
        "disclosure": { "type": "string", "minLength": 1 }
      }
    },
    "visualRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "subject", "assetRef", "sourceClass", "textFree", "synthetic", "pocOnly"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["hero_visual", "guide_character", "concept_visual", "equipment_visual"] },
        "subject": { "type": "string", "minLength": 1 },
        "assetRef": { "type": ["string", "null"] },
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "textFree": { "type": "boolean" },
        "synthetic": { "type": "boolean" },
        "pocOnly": { "type": "boolean" }
      }
    },
    "layoutIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "regions", "readingOrder", "safeAreas"],
      "properties": {
        "kind": { "enum": ["hero", "step_process", "safety_focus"] },
        "regions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/region" } },
        "readingOrder": { "type": "array", "items": { "type": "string" } },
        "safeAreas": { "type": "array", "items": { "$ref": "#/$defs/region" } }
      }
    },
    "motionIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "targetIds", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "targetIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "action": { "enum": ["reveal", "synchronized_reveal", "sequential_reveal", "slow_zoom", "focus"] },
        "atMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 1 },
        "intensity": { "enum": ["very_subtle", "subtle"] }
      }
    },
    "presentationIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "visualIntent", "layout", "motionIntent"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "visualIntent": {
          "type": "object", "additionalProperties": false,
          "required": ["summary", "requirements"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "requirements": { "type": "array", "items": { "$ref": "#/$defs/visualRequirement" } }
          }
        },
        "layout": { "$ref": "#/$defs/layoutIntent" },
        "motionIntent": { "type": "array", "items": { "$ref": "#/$defs/motionIntent" } }
      }
    },
    "narrationSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["script", "language", "voiceProfile", "audioAssetRef", "approvedDurationMs", "cues"],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "voiceProfile": { "type": "string", "minLength": 1 },
        "audioAssetRef": { "type": ["string", "null"] },
        "approvedDurationMs": { "type": ["integer", "null"], "minimum": 1 },
        "cues": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "phrase", "targetIds"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "phrase": { "type": "string", "minLength": 1 },
              "targetIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "groundingSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRefs", "sourceClass", "verified", "anchor", "replacementRequirement", "releaseScope"],
      "properties": {
        "sourceRefs": { "type": "array", "items": { "type": "string" } },
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "verified": { "type": "boolean" },
        "anchor": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["id", "status", "assetRef", "bounds", "confirmedBy"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "status": { "enum": ["unresolved", "approved_for_poc_only", "verified"] },
                "assetRef": { "type": ["string", "null"] },
                "bounds": { "anyOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }] },
                "confirmedBy": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "replacementRequirement": { "type": ["string", "null"] },
        "releaseScope": { "$ref": "#/$defs/releaseScope" }
      }
    },
    "slideGovernance": {
      "type": "object", "additionalProperties": false,
      "required": ["riskLevel", "reviewStatus", "requiredReviewGates", "releaseBlockers"],
      "properties": {
        "riskLevel": { "enum": ["illustrative", "procedural_general", "device_specific"] },
        "reviewStatus": { "$ref": "#/$defs/reviewStatus" },
        "requiredReviewGates": { "type": "array", "items": { "type": "string" } },
        "releaseBlockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "slideSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "type", "knowledge", "presentation", "narration", "grounding", "governance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["hero", "step_process", "safety_focus"] },
        "knowledge": { "$ref": "#/$defs/knowledgeBlock" },
        "presentation": { "$ref": "#/$defs/presentationIntent" },
        "narration": { "$ref": "#/$defs/narrationSpec" },
        "grounding": { "$ref": "#/$defs/groundingSpec" },
        "governance": { "$ref": "#/$defs/slideGovernance" }
      }
    },
    "reviewDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "gateId", "decision", "reviewer", "reviewedAt", "scope", "comments", "acceptedRisks"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "gateId": { "type": "string", "minLength": 1 },
        "decision": { "$ref": "#/$defs/reviewStatus" },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "scope": { "$ref": "#/$defs/releaseScope" },
        "comments": { "type": "string" },
        "acceptedRisks": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "rationale"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "courseGovernance": {
      "type": "object", "additionalProperties": false,
      "required": ["lifecycleState", "targetReleaseScope", "reviewDecisions", "securityScanRequired"],
      "properties": {
        "lifecycleState": { "enum": ["candidate", "normalized", "validated", "review_required", "approved_for_poc_use", "approved_for_release", "changes_required", "rejected"] },
        "targetReleaseScope": { "$ref": "#/$defs/releaseScope" },
        "reviewDecisions": { "type": "array", "items": { "$ref": "#/$defs/reviewDecision" } },
        "securityScanRequired": { "type": "boolean" }
      }
    }
  }
}
